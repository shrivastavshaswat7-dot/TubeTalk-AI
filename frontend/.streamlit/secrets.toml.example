# Copy to secrets.toml (git-ignored) for Streamlit Cloud / local use. None of these are secret.
API_BASE_URL = "http://localhost:8000"
# Google sign-in through Supabase Auth
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "your_supabase_publishable_or_anon_key"  # public by design; never the service-role key
APP_URL = "http://localhost:8501"  # this app's own address (Google returns here after sign-in)
