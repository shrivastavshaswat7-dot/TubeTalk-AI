# Copy to backend/.env and fill in real values locally. NEVER commit real keys.

# --- Backend ---
APP_ENV=development
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_groq_model_name_here
SUPABASE_URL=your_supabase_project_url_here
# Use the service-role key; backend only. Never expose it to the frontend.
SUPABASE_KEY=your_supabase_service_role_key_here
ALLOWED_ORIGINS=http://localhost:8501

# --- RAG settings (initial experimental values) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# Similarity a topic starter question must reach to be suggested (not used to gate answers)
MIN_SIMILARITY=0.25
# Transcripts up to this many (estimated) tokens are given to the model whole; longer ones use TOP_K chunks
FULL_CONTEXT_MAX_TOKENS=6000
# Reasoning models need a generous output cap; set GROQ_REASONING_EFFORT empty for non-reasoning models
GROQ_MAX_TOKENS=8192
GROQ_REASONING_EFFORT=low
# Load the embedding model in the background at startup
WARMUP_EMBEDDINGS=true

# --- Frontend ---
API_BASE_URL=http://localhost:8000
